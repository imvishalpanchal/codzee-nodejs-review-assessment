{
  "name": "codzee-nodejs-review-assessment",
  "version": "1.0.0",
  "description": "Task & Project Management REST API built with Node.js, Express, Prisma, and SQLite for Codzee Code Review Evaluation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "test": "DATABASE_URL=\"file:./test.db\" jest --runInBand --detectOpenHandles --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testTimeout": 30000
  },
  "keywords": [
    "nodejs",
    "express",
    "prisma",
    "sqlite",
    "codzee",
    "rest-api"
  ],
  "author": "Vishal Panchal",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0"
  }
}
